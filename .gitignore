# ==============================================================================
# LegacyLens AI - Git Ignore Policy
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment Variables & Secrets (NEVER commit secrets!)
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx

# Except example template:
!.env.example

# Local development wrappers
.bin/

# Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
*.egg

# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class

# Testing, Linting & Type Checking Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Application Runtime Storage & Dynamic Artifacts
backend/storage/*
!backend/storage/.gitkeep
storage/
*.db
*.sqlite
*.sqlite3
*.docx

# .NET / C# Build Outputs (for analyzed codebases)
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esults/
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
.idea/
.vscode/
*.swp
*.swo

# Symlinks created for development
mcp_server
